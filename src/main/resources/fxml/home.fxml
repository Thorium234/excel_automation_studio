<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.excelstudio.controller.HomeController"
            fitToWidth="true"
            styleClass="scroll-area">
    <VBox styleClass="content-card" spacing="16">
        <Label text="Session overview" styleClass="card-title"/>
        <Label text="Start a session before running exercises. Elapsed time only advances while the session is running."
               wrapText="true" styleClass="card-subtitle"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Duration" styleClass="field-label" minWidth="90"/>
            <ComboBox fx:id="durationPreset" prefWidth="150"/>
            <Label text="Custom" styleClass="field-label"/>
            <TextField fx:id="customHours" prefWidth="60"/>
            <Label text="h" styleClass="field-label"/>
            <TextField fx:id="customMinutes" prefWidth="60"/>
            <Label text="min" styleClass="field-label"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="startButton" text="Start" onAction="#startSession" styleClass="primary-button"/>
            <Button fx:id="pauseButton" text="Pause" onAction="#pauseSession" styleClass="secondary-button"/>
            <Button fx:id="resumeButton" text="Resume" onAction="#resumeSession" styleClass="secondary-button"/>
            <Button fx:id="stopButton" text="Stop" onAction="#stopSession" styleClass="secondary-button"/>
            <Button fx:id="completeButton" text="Complete" onAction="#completeSession" styleClass="secondary-button"/>
        </HBox>

        <GridPane hgap="16" vgap="8">
            <Label text="Planned duration" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="durationValue" text="Not configured" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Elapsed" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="elapsedValue" text="00:00:00" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Remaining" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="remainingValue" text="00:00:00" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Current task" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="taskValue" text="None" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Completed exercises" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="completedValue" text="0" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Session state" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="stateValue" text="IDLE" styleClass="field-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>

        <ProgressBar fx:id="sessionProgress" progress="0" maxWidth="Infinity"/>
        <Label fx:id="feedback" text="" wrapText="true" styleClass="feedback-label"/>

        <VBox spacing="6" styleClass="info-block">
            <Label text="Execution log" styleClass="card-title-small"/>
            <ListView fx:id="logList" prefHeight="200"/>
            <Button text="Refresh log" onAction="#refreshLog" styleClass="secondary-button"/>
        </VBox>

        <VBox spacing="6" styleClass="info-block">
            <Label text="Modules" styleClass="card-title-small"/>
            <Label text="Excel automation: generate a task, run it in a practice workbook and validate the saved result."
                   wrapText="true" styleClass="card-subtitle"/>
            <Label text="Programming automation: planned for a later phase and not part of the initial release."
                   wrapText="true" styleClass="card-subtitle"/>
        </VBox>
    </VBox>
</ScrollPane>
