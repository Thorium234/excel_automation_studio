<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.excelstudio.controller.SettingsController"
      styleClass="content-card"
      spacing="16"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <Label text="Settings" styleClass="card-title"/>
    <Label text="Settings are stored locally and applied when the matching module starts."
           wrapText="true" styleClass="card-subtitle"/>

    <GridPane hgap="14" vgap="12">
        <Label text="Output directory" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="outputDirectory" prefWidth="380" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Spreadsheet application" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="spreadsheetApplication" prefWidth="380" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Default session (minutes)" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="defaultSessionMinutes" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Emergency stop key" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="emergencyStopKey" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <Button text="Save settings" onAction="#save" styleClass="primary-button"/>

    <Label fx:id="feedback" text="" wrapText="true" styleClass="feedback-label"/>
</VBox>
