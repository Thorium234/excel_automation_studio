<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.excelstudio.controller.DashboardController"
            styleClass="app-root">
    <left>
        <VBox styleClass="sidebar" spacing="8">
            <Label text="Excel Studio" styleClass="brand"/>
            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Excel" onAction="#showExcel" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Settings" onAction="#showSettings" maxWidth="Infinity" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <Label text="Dashboard" styleClass="page-title"/>
            <StackPane fx:id="contentArea" styleClass="content-card" VBox.vgrow="ALWAYS">
                <VBox spacing="12" alignment="TOP_LEFT">
                    <Label text="Session overview" styleClass="card-title"/>
                    <Label text="Excel automation module"/>
                    <Label fx:id="statusLabel" text="Ready" styleClass="status-label"/>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
